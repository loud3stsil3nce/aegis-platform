# ==========================================
# 🛡️ Aegis Platform Environment Variables
# ==========================================

# PostgreSQL credentials shared by the Aegis service databases.
# Generate a unique production value; never commit the real password.
AEGIS_POSTGRES_USER=Rafiur
AEGIS_POSTGRES_PASSWORD=replace_with_a_long_random_password
SRE_DB_USER=aegis_sre_app
SRE_DB_PASSWORD=replace_with_a_distinct_long_random_password
SCREENER_DB_USER=shariah_screener_app
SCREENER_DB_PASSWORD=replace_with_a_distinct_long_random_password
REEF_DB_USER=reeftracker_app_role
REEF_DB_PASSWORD=replace_with_a_distinct_long_random_password
MESSAGING_DB_USER=e2ee_messenger_app
MESSAGING_DB_PASSWORD=replace_with_a_distinct_long_random_password
# Use the server's Tailscale address when remote development access is needed.
AEGIS_DB_BIND_ADDRESS=127.0.0.1

# ------------------------------------------
# 🤖 1. SRE Diagnostic Agent (sre-agent)
# ------------------------------------------
# AI Reasoning LLM Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Jira Cloud Integration (Automated Ticketing)
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your_email@domain.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SRE

# GitHub failure intake and read-only diagnosis. Use a dedicated GitHub App;
# never reuse the proposal App or a broad personal access token.
AEGIS_GITHUB_ALLOWED_REPOSITORIES=loud3stsil3nce/aegis-platform
AEGIS_GITHUB_READ_APP_ID=replace_with_read_app_id
AEGIS_GITHUB_READ_INSTALLATION_ID=replace_with_read_installation_id
AEGIS_GITHUB_READ_PRIVATE_KEY_FILE=/run/secrets/aegis-github-read-app.pem
AEGIS_GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/aegis-github-webhook-secret
AEGIS_GITHUB_READ_PRIVATE_KEY_HOST_PATH=/owner-only/path/aegis-github-read-app.pem
AEGIS_GITHUB_WEBHOOK_SECRET_HOST_PATH=/owner-only/path/aegis-github-webhook-secret
AEGIS_SRE_PHASE_A_IMAGE=aegis/sre-agent:phase-a-source-sha256
AEGIS_GITHUB_POLL_ENABLED=0
AEGIS_GITHUB_POLL_INTERVAL_SECONDS=60
AEGIS_GITHUB_POLL_LOOKBACK_MINUTES=15

# Agent Scheduler
CRON_INTERVAL_MINUTES=30

# External SRE MCP and Jira webhook authentication. Generate independent,
# high-entropy values for production.
AEGIS_MCP_API_KEY=replace_with_a_long_random_service_token
AEGIS_JIRA_WEBHOOK_SECRET=replace_with_a_different_random_webhook_secret
AEGIS_DOCKER_OBSERVER_TOKEN=replace_with_a_third_random_internal_token

# Phase 6 governed restart proxy. Keep this independent from every other
# credential. Only plugin-declared lifecycle targets belong in this allowlist.
AEGIS_DOCKER_LIFECYCLE_TOKEN_FILE=/path/to/aegis-secrets/deployment/lifecycle-token
AEGIS_LIFECYCLE_ALLOWED_TARGETS=hello-aegis-hello-aegis-1
AEGIS_DEPLOYMENT_ACTORS_FILE=/path/to/aegis-secrets/deployment/actors.json
AEGIS_DEPLOYMENT_REQUESTER_TOKEN_FILE=/path/to/aegis-secrets/deployment/requester-token
AEGIS_DEPLOYMENT_APPROVER_TOKEN_FILE=/path/to/aegis-secrets/deployment/approver-token
AEGIS_DEPLOYMENT_EXECUTOR_TOKEN_FILE=/path/to/aegis-secrets/deployment/executor-token
AEGIS_DEPLOYMENT_UID=1000
AEGIS_DEPLOYMENT_GID=1000
AEGIS_DOCKER_SOCKET_GID=983

# Transitional observability allowlist. The plugin registry will replace this
# once Phase 2 is complete.
AEGIS_ALLOWED_CONTAINERS=shariahscreener,reeftracker_app,e2ee_messenger

# Bind the SRE API to loopback by default. The Zenbook uses its Tailscale IP.
AEGIS_SRE_BIND_ADDRESS=127.0.0.1

# Optional Phase 4 cloud model adapter. The key itself is stored in this
# owner-only file, never in this environment file. Update prices when changing
# the model; they are used to enforce per-run cost budgets.
OPENROUTER_API_KEY_FILE=/path/to/aegis-secrets/openrouter/api-key
AEGIS_OPENROUTER_MODEL=openai/gpt-4.1-mini
AEGIS_OPENROUTER_INPUT_COST_PER_MILLION=0.40
AEGIS_OPENROUTER_OUTPUT_COST_PER_MILLION=1.60
AEGIS_OLLAMA_MODEL=qwen2.5-coder:7b-instruct
# Set these to the owner of the 0600 provider-secret file on the deployment host.
AEGIS_RUNTIME_UID=10001
AEGIS_RUNTIME_GID=10001

# Optional Open WebUI client. Its secret is persisted as an owner-only file in
# the external Open WebUI data volume. Bind only to loopback or Tailscale.
OPEN_WEBUI_BIND=127.0.0.1


# ------------------------------------------
# 🕌 2. Shariah Compliant Screener (shariahscreener)
# ------------------------------------------
# AI Segment Auditor & Stock Analyst
GEMINI_API_KEY=your_gemini_api_key_here

# External Financial Data Harvesters
FMP_API_KEY=your_fmp_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here


# ------------------------------------------
# 🔐 3. E2EE Messenger (e2ee-messenger)
# ------------------------------------------
ENCRYPTION_KEY=your_secret_encryption_key_here
