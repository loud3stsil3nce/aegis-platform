FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ARG AEGIS_DEPLOYMENT_UID=10004
ARG AEGIS_DEPLOYMENT_GID=10004

WORKDIR /app
COPY core/change_management/requirements.deployment-api.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY core /app/core

RUN groupadd --system --gid ${AEGIS_DEPLOYMENT_GID} deployment-api \
    && useradd --system --uid ${AEGIS_DEPLOYMENT_UID} --gid ${AEGIS_DEPLOYMENT_GID} deployment-api \
    && mkdir -p /var/lib/aegis-image-deployment \
    && chown deployment-api:deployment-api /var/lib/aegis-image-deployment

USER deployment-api

CMD ["uvicorn", "core.change_management.deployment_server:app", "--host", "0.0.0.0", "--port", "8014"]

